# Tesseract OCR language(s) — default is Italian + English
# Add more with "+", e.g. "ita+eng+fra". Full list: https://tesseract-ocr.github.io/tessdoc/Data-Files
TESSERACT_LANG=ita+eng

# Server
PORT=3089

# Instagram session cookie — copy from Chrome DevTools → Application → Cookies → instagram.com → sessionid
INSTAGRAM_SESSION_ID=instagram_session_id_here

# Tesseract confidence score
OCR_CONFIDENCE_THRESHOLD=
